        "#Student Study & Assessment Tracker\n",
        "import csv\n",
        "import os\n",
        "from datetime import datetime, date\n",
        "\n",
        "DATA_FILE = 'assessments.csv'\n",
        "FIELDS = ['unit', 'assessment', 'due_date', 'weight', 'total_marks', 'marks_obtained']\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def load_assessments():\n",
        "    if not os.path.exists(DATA_FILE):\n",
        "        return []\n",
        "    try:\n",
        "        with open(DATA_FILE, 'r', newline='', encoding='utf-8') as file:\n",
        "            reader = csv.DictReader(file)\n",
        "            if reader.fieldnames != FIELDS:\n",
        "                print('Warning: CSV headings do not match this program. No data loaded.')\n",
        "                return []\n",
        "            return list(reader)\n",
        "    except (OSError, csv.Error) as error:\n",
        "        print('Could not load assessments:', error)\n",
        "        return []"
      ],
      "metadata": {
        "id": "nhjudItXR8l-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def save_assessments(assessments):\n",
        "    try:\n",
        "        with open(DATA_FILE, 'w', newline='', encoding='utf-8') as file:\n",
        "            writer = csv.DictWriter(file, fieldnames=FIELDS)\n",
        "            writer.writeheader()\n",
        "            writer.writerows(assessments)\n",
        "        return True\n",
        "    except OSError as error:\n",
        "        print('Could not save assessments:', error)\n",
        "        return False\n",
        "\n",
        "\n",
        "def get_number(prompt, minimum, maximum):\n",
        "    while True:\n",
        "        try:\n",
        "            value = float(input(prompt))\n",
        "            if minimum <= value <= maximum:\n",
        "                return value\n",
        "            print(f'Enter a number between {minimum} and {maximum}.')\n",
        "        except ValueError:\n",
        "            print('Please enter a number.')"
      ],
      "metadata": {
        "id": "XDoqq6X1SBdq"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def get_integer(prompt, minimum, maximum):\n",
        "    while True:\n",
        "        raw = input(prompt).strip()\n",
        "        if raw.isdigit() and minimum <= int(raw) <= maximum:\n",
        "            return int(raw)\n",
        "        print(f'Enter a whole number from {minimum} to {maximum}.')\n",
        "\n",
        "\n",
        "def get_date():\n",
        "    while True:\n",
        "        value = input('Due date (YYYY-MM-DD): ').strip()\n",
        "        try:\n",
        "            datetime.strptime(value, '%Y-%m-%d')\n",
        "            return value\n",
        "        except ValueError:\n",
        "            print('Enter a real date in YYYY-MM-DD format.')\n"
      ],
      "metadata": {
        "id": "iv_l-KA7SFr7"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def add_assessment(assessments):\n",
        "    unit = input('Unit code/name: ').strip()\n",
        "    name = input('Assessment name: ').strip()\n",
        "    if not unit or not name:\n",
        "        print('Unit and assessment names cannot be blank.')\n",
        "        return\n",
        "    due_date = get_date()\n",
        "    current_weight = sum(float(a['weight']) for a in assessments if a['unit'].lower() == unit.lower())\n",
        "    if current_weight >= 100:\n",
        "        print('This unit already has 100% assessment weighting recorded.')\n",
        "        return\n",
        "    weight = get_number('Assessment weight (%): ', 0.01, 100 - current_weight)\n",
        "    total = get_number('Total possible marks: ', 0.01, 1000000)\n",
        "    new_assessment = ({'unit': unit, 'assessment': name, 'due_date': due_date,\n",
        "                        'weight': str(weight), 'total_marks': str(total), 'marks_obtained': ''})\n",
        "   proposed = assessments + [new_assessment]\n",
        "    if save_assessments(proposed):\n",
        "        assessments[:] = proposed\n",
        "        print('Assessment saved.')"
      ],
      "metadata": {
        "id": "bXTgaXlVSQ6l"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def view_assessments(assessments):\n",
        "    if not assessments:\n",
        "        print('No assessments recorded.')\n",
        "        return\n",
        "    for number, a in enumerate(assessments, start=1):\n",
        "        result = a['marks_obtained'] or 'Not graded'\n",
        "        print(f\"{number}. {a['unit']} | {a['assessment']} | Due: {a['due_date']} | \"\n",
        "              f\"Weight: {a['weight']}% | Mark: {result}/{a['total_marks']}\")\n",
        "\n",
        "\n",
        "def record_mark(assessments):\n",
        "    if not assessments:\n",
        "        print('Add an assessment first.')\n",
        "        return\n",
        "    view_assessments(assessments)\n",
        "    index = get_integer('Assessment number: ', 1, len(assessments)) - 1\n",
        "    total = float(assessments[index]['total_marks'])\n",
        "    mark = get_number('Marks obtained: ', 0, total)\n",
        "    assessments[index]['marks_obtained'] = str(mark)\n",
        "    if save_assessments(assessments):\n",
        "        print('Mark saved.')\n"
      ],
      "metadata": {
        "id": "pxn8ZJ1dSTqh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def calculate_grades(assessments):\n",
        "    unit = input('Enter unit code/name: ').strip()\n",
        "    matching = [a for a in assessments if a['unit'].lower() == unit.lower()]\n",
        "    if not matching:\n",
        "        print('No assessments for that unit.')\n",
        "        return\n",
        "    earned = 0.0\n",
        "    graded_weight = 0.0\n",
        "    for a in matching:\n",
        "        if a['marks_obtained'] != '':\n",
        "            weight = float(a['weight'])\n",
        "            contribution = float(a['marks_obtained']) / float(a['total_marks']) * weight\n",
        "            earned += contribution\n",
        "            graded_weight += weight\n",
        "            print(f\"{a['assessment']}: {contribution:.2f} percentage points\")\n",
        "    print(f'Weighted points earned: {earned:.2f} / 100')\n",
        "    print(f'Graded weighting: {graded_weight:.2f}%')\n",
        "    if graded_weight:\n",
        "        print(f'Average on graded work: {earned / graded_weight * 100:.2f}%')\n",
        "    else:\n",
        "        print('No marks have been entered yet.')\n",
        "    target = get_number('Target final grade (%): ', 0, 100)\n",
        "    remaining = 100 - graded_weight\n",
        "    if remaining <= 0:\n",
        "        print('All weighting graded; final result:', f'{earned:.2f}%')\n",
        "    else:\n",
        "        required = (target - earned) / remaining * 100\n",
        "        if required > 100:\n",
        "             print('Target is not achievable with remaining weighting.')\n",
        "        elif required <= 0:\n",
        "            print('Target already secured based on recorded results.')\n",
        "        else:\n",
        "            print(f'Average needed on remaining {remaining:.2f}% weighting: {required:.2f}%')\n",
        "    recorded_weight = sum(float(a['weight']) for a in matching)\n",
        "    if recorded_weight < 100:\n",
        "        print('Note: Not all unit assessments have been entered; target assumes a 100%-weighted unit.')\n"
      ],
      "metadata": {
        "id": "aaTPrwENSYzr"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def upcoming_assessments(assessments):\n",
        "    today = date.today()\n",
        "    upcoming = []\n",
        "    for a in assessments:\n",
        "        due = datetime.strptime(a['due_date'], '%Y-%m-%d').date()\n",
        "        days = (due - today).days\n",
        "        if a['marks_obtained'] == '':\n",
        "            upcoming.append((days, a))\n",
        "\n",
        "    def get_days(item):\n",
        "        return item[0]\n",
        "\n",
        "    upcoming.sort(key=get_days)\n",
        "    if not upcoming:\n",
        "        print('No upcoming ungraded assessments.')\n",
        "    for days, a in upcoming:\n",
        "if days < 0\n",
         "   status = f'Overdue by {abs(days)} day(s)'\n",
        "elif days == 0:\n",
         "   status = 'Due today'\n",
        "else:\n",
         "   status = f'Due in {days} day(s)'\n",

        "print(\n",
         "   f\"{a['unit']} - {a['assessment']}:\"\n",
          "  f\"{status}; weight {a['weight']}%\"\n",
     " \n",
      "metadata": {
