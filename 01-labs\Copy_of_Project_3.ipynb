      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def delete_assessment(assessments):\n",
        "    if not assessments:\n",
        "        print('No assessments to delete.')\n",
        "        return\n",
        "    view_assessments(assessments)\n",
        "    index = get_integer('Assessment number to delete: ', 1, len(assessments)) - 1\n",
        "    if input('Type YES to confirm deletion: ').strip() == 'YES':\n",
        "        removed = assessments.pop(index)\n",
        "        if save_assessments(assessments):\n",
        "            print('Deleted:', removed['assessment'])\n",
        "    else:\n",
        "        print('Deletion cancelled.')"
      ],
      "metadata": {
        "id": "mRj1PdvqS0rd"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def main():\n",
        "    assessments = load_assessments()\n",
        "    while True:\n",
        "        print('\\n--- STUDENT STUDY & ASSESSMENT TRACKER ---')\n",
        "        print('1. Add assessment')\n",
        "        print('2. View assessments')\n",
        "        print('3. Record a mark')\n",
        "        print('4. Calculate grades and target')\n",
        "        print('5. Upcoming deadlines')\n",
        "        print('6. Delete assessment')\n",
        "        print('7. Exit')\n",
        "        choice = get_integer('Choose 1-7: ', 1, 7)\n",
        "        if choice == 1:\n",
        "            add_assessment(assessments)\n",
        "        elif choice == 2:\n",
        "            view_assessments(assessments)\n",
        "        elif choice == 3:\n",
        "            record_mark(assessments)\n",
        "        elif choice == 4:\n",
        "            calculate_grades(assessments)\n",
        "        elif choice == 5:\n",
        "            upcoming_assessments(assessments)\n",
        "        elif choice == 6:\n",
        "            delete_assessment(assessments)\n",
        "        else:\n",
        "            print('Goodbye!')\n",
        "            break\n",
        "\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    main()"
      ],
